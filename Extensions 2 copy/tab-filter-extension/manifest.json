{
  "manifest_version": 3,
  "name": "Tab Odds Filter",
  "version": "1.0",
  "description": "Closes tabs where no back odds fall in range 1.80 <= x <= 1.88 in #market0",
  "permissions": [
    "tabs",
    "scripting",
    "activeTab",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}